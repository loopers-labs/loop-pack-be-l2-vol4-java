pipeline {
    agent {
        label 'product-ranking-docker'
    }

    triggers {
        cron('30 1 * * *')
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 2, unit: 'HOURS')
        buildDiscarder(logRotator(daysToKeepStr: '30', numToKeepStr: '50'))
        timestamps()
    }

    parameters {
        string(
            name: 'TARGET_DATE',
            defaultValue: '',
            description: '수동 실행 집계 기준일(yyyyMMdd). 비워두면 Asia/Seoul 기준 전일을 사용합니다.'
        )
        string(
            name: 'REBUILD_SEQUENCE',
            defaultValue: '',
            description: '완료된 날짜를 원천 정정으로 다시 집계할 때만 증가한 양의 정수를 입력합니다.'
        )
        string(
            name: 'BATCH_IMAGE',
            defaultValue: 'loopers/commerce-batch:approved',
            description: '단일 Docker agent에 보관할 승인된 Batch 이미지 태그입니다.'
        )
        booleanParam(
            name: 'REFRESH_IMAGE',
            defaultValue: false,
            description: '수동 실행에서만 테스트, BootJar 생성, 이미지 갱신을 수행합니다.'
        )
    }

    environment {
        COMPOSE_PROJECT_NAME = 'docker'
        MYSQL_CREDENTIALS_ID = 'product-ranking-mysql'
    }

    stages {
        stage('Resolve parameters') {
            steps {
                script {
                    def timerCauses = currentBuild
                        .getBuildCauses('hudson.triggers.TimerTrigger$TimerTriggerCause')
                    boolean scheduled = !timerCauses.isEmpty()
                    String requestedDate = params.TARGET_DATE.trim()
                    String rebuildSequence = params.REBUILD_SEQUENCE.trim()
                    String image = params.BATCH_IMAGE.trim()

                    if (scheduled && !requestedDate.isEmpty()) {
                        error('예약 실행에는 TARGET_DATE를 지정할 수 없습니다.')
                    }
                    if (scheduled && !rebuildSequence.isEmpty()) {
                        error('예약 실행에는 REBUILD_SEQUENCE를 지정할 수 없습니다.')
                    }
                    if (scheduled && params.REFRESH_IMAGE) {
                        error('예약 실행에서는 이미지를 갱신할 수 없습니다.')
                    }
                    if (!rebuildSequence.isEmpty() && !(rebuildSequence ==~ /[1-9][0-9]*/)) {
                        error('REBUILD_SEQUENCE는 비어 있거나 1 이상의 정수여야 합니다.')
                    }
                    if (image.isEmpty() || !(image ==~ /[A-Za-z0-9._:@\/-]+/)) {
                        error('BATCH_IMAGE에 유효한 Docker 이미지 참조를 입력하세요.')
                    }

                    def formatter = java.time.format.DateTimeFormatter
                        .ofPattern('uuuuMMdd')
                        .withResolverStyle(java.time.format.ResolverStyle.STRICT)
                    String targetDate
                    if (scheduled || requestedDate.isEmpty()) {
                        targetDate = java.time.LocalDate
                            .now(java.time.ZoneId.of('Asia/Seoul'))
                            .minusDays(1)
                            .format(formatter)
                    } else {
                        targetDate = requestedDate
                    }

                    if (!(targetDate ==~ /[0-9]{8}/)) {
                        error('TARGET_DATE 형식은 yyyyMMdd여야 합니다.')
                    }
                    try {
                        java.time.LocalDate.parse(targetDate, formatter)
                    } catch (java.time.format.DateTimeParseException ignored) {
                        error('TARGET_DATE가 유효한 날짜가 아닙니다.')
                    }

                    env.IS_SCHEDULED = scheduled.toString()
                    env.RESOLVED_TARGET_DATE = targetDate
                    env.RESOLVED_REBUILD_SEQUENCE = scheduled ? '' : rebuildSequence
                    env.BATCH_IMAGE = image
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${targetDate}"
                    currentBuild.description = scheduled
                        ? "scheduled: ${image}"
                        : "manual: ${image}"
                }
            }
        }

        stage('Manual image refresh') {
            when {
                expression {
                    env.IS_SCHEDULED == 'false' && params.REFRESH_IMAGE
                }
            }
            steps {
                sh(
                    label: 'Test and build Batch BootJar',
                    script: './gradlew :apps:commerce-batch:clean :apps:commerce-batch:test :apps:commerce-batch:bootJar'
                )
                sh(
                    label: 'Build approved Batch image',
                    script: 'docker build --file apps/commerce-batch/Dockerfile --tag "${BATCH_IMAGE}" .'
                )
            }
        }

        stage('Scheduled image selection') {
            when {
                expression {
                    env.IS_SCHEDULED == 'true'
                }
            }
            steps {
                echo "예약 실행은 agent의 기존 승인 이미지 ${env.BATCH_IMAGE}를 사용합니다."
            }
        }

        stage('Verify image') {
            steps {
                sh(
                    label: 'Verify local Batch image',
                    script: 'docker image inspect "${BATCH_IMAGE}" >/dev/null'
                )
            }
        }

        stage('Run product ranking aggregation') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.MYSQL_CREDENTIALS_ID,
                        usernameVariable: 'MYSQL_USER',
                        passwordVariable: 'MYSQL_PWD'
                    )
                ]) {
                    sh(
                        label: 'Run one-shot Batch container',
                        script: '''#!/usr/bin/env bash
set -Eeuo pipefail

compose_options=(
  --file docker/infra-compose.yml
  --file docker/batch-compose.yml
  --profile batch
)
batch_parameters=("targetDate=${RESOLVED_TARGET_DATE}")

if [[ -n "${RESOLVED_REBUILD_SEQUENCE}" ]]; then
  batch_parameters+=("rebuildSequence=${RESOLVED_REBUILD_SEQUENCE}")
fi

docker compose --project-name "${COMPOSE_PROJECT_NAME}" "${compose_options[@]}" config --quiet
docker compose --project-name "${COMPOSE_PROJECT_NAME}" "${compose_options[@]}" run \
  --rm \
  --no-deps \
  product-ranking-batch \
  "${batch_parameters[@]}"
'''
                    )
                }
            }
        }
    }

    post {
        success {
            echo "상품 랭킹 집계가 성공했습니다: targetDate=${env.RESOLVED_TARGET_DATE}"
        }
        failure {
            echo '상품 랭킹 집계가 실패했습니다. 컨테이너 종료와 BATCH_JOB_EXECUTION 상태를 먼저 확인하세요.'
            echo '정상 FAILED 상태라면 같은 targetDate와 rebuildSequence로 다시 실행합니다.'
        }
    }
}
